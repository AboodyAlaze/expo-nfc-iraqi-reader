{
  "expo": {
    "name": "expo-nfc-iraqi-reader-example",
    "slug": "expo-nfc-iraqi-reader-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      ["expo-nfc-iraqi-reader", { "nfcPermission": "لقراءة بيانات البطاقة الوطنية عبر NFC" }]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fullship.nfciraqireader.example",
      "appleTeamId": "28WN5DTH9W"
    },
    "android": {
      "package": "expo.modules.nfciraqireader.example",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
